# NavBudol backend — copy this file to .env and fill in the real keys.
# The real .env is gitignored and must never be committed or shipped in the app.

# From https://aistudio.google.com — while you're there, confirm the exact
# model ID string for Gemini 3.5 Flash Lite (a -preview suffix variant may exist).
GEMINI_API_KEY=PASTE_YOUR_AI_STUDIO_KEY_HERE

# Your Fish Audio key
FISH_API_KEY=PASTE_YOUR_FISH_AUDIO_KEY_HERE

# Model id — only change if AI Studio shows a different exact string
GEMINI_MODEL=gemini-3.5-flash-lite
